import React, { useState } from 'react';
import dummyMenu from '../data/dummyMenu';
import MenuListItem from '../components/MenuListItem';
import MenuGridCard from '../components/MenuGridCard';
import { useToast } from '@/components/ui/Toast';
import { useCart } from '@/features/cart';

export const MenuPage = () => {
  const [search, setSearch] = useState('');
  const toast = useToast();
  const { addItem } = useCart();

  const handleAddToCart = (item) => {
    addItem(item);
    toast.success(`${item.name} added to cart`, 'Cart Updated');
  };

  const filteredItems = dummyMenu.filter((item) => {
    const query = search.trim().toLowerCase();
    if (!query) return true;
    return (
      item.name.toLowerCase().includes(query) ||
      item.description.toLowerCase().includes(query)
    );
  });

  return (
    <div className="min-h-screen bg-[var(--bg)] text-[var(--ink)] px-5 sm:px-10 py-8 sm:py-12">
      <style>{`
        :root, [data-theme="locker"] {
          --bg: #F4F0E8;
          --surface: #FFFFFF;
          --ink: #1B2430;
          --ink-soft: #64748B;
          --primary: #F97316;
          --band-1: #FED7AA;
          --band-2: #BAE6FD;
          --band-3: #DDD6FE;
          --band-4: #BBF7D0;
          --band-5: #FEF08A;
        }
        [data-theme="blackboard"] {
          --bg: #18181B;
          --surface: #27272A;
          --ink: #FAFAFA;
          --ink-soft: #A1A1AA;
          --primary: #FACC15;
          --band-1: #3F3F46;
          --band-2: #334155;
          --band-3: #374151;
          --band-4: #2D3748;
          --band-5: #44403C;
        }
        [data-theme="pistachio"] {
          --bg: #F2F7F4;
          --surface: #FFFFFF;
          --ink: #1E2D24;
          --ink-soft: #5C7164;
          --primary: #2D6A4F;
          --band-1: #D8F3DC;
          --band-2: #B7E4C7;
          --band-3: #E9D8A6;
          --band-4: #DDF0ED;
          --band-5: #E2E8F0;
        }
        [data-theme="strawberry-milk"], [data-theme="strawberry milk"] {
          --bg: #FFF5F7;
          --surface: #FFFFFF;
          --ink: #3D1C24;
          --ink-soft: #8C626C;
          --primary: #E11D48;
          --band-1: #FFE4E6;
          --band-2: #FECDD3;
          --band-3: #FED7AA;
          --band-4: #E0E7FF;
          --band-5: #F5D0FE;
        }
      `}</style>

      <main className="max-w-[1240px] mx-auto flex flex-col gap-8">
        <header className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <h1 className="font-title text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--ink)]">
            The Lunchroom
          </h1>

          <div className="w-full md:w-72">
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search menu..."
              aria-label="Search menu"
              className="w-full h-11 px-4 rounded-[12px] bg-[var(--surface)] text-[var(--ink)] placeholder:text-[var(--ink-soft)] border-2 border-[var(--ink)] focus:outline-none text-sm"
